{
  "name": "prosklitirio",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute prosklitirio-db --local --file=schema.sql",
    "db:create": "wrangler d1 create prosklitirio-db",
    "db:init:remote": "wrangler d1 execute prosklitirio-db --remote --file=schema.sql",
    "deploy": "wrangler pages deploy",
    "set-password": "wrangler pages secret put ADMIN_PASSWORD"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
